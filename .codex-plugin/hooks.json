{
  "description": "Load ASD-STE100 rules automatically for each Codex session.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"${PLUGIN_ROOT}\" ] && node \"${PLUGIN_ROOT}/skills/ste100/hooks/ste100-activate.js\" || true",
            "timeout": 5,
            "statusMessage": "Loading ASD-STE100...",
            "additionalContextLimit": 0
          }
        ]
      }
    ]
  }
}
